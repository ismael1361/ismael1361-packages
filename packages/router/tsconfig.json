{
    "ts-node": {
        "esm": true,
        "experimentalSpecifierResolution": "node"
    },
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": [
            "es6",
            "esnext"
        ],
        "rootDir": "./src",
        "outDir": "./dist",
        "declarationDir": "./dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}