{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2020",
        "lib": [
            "es2020"
        ],
        "allowJs": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "declarationDir": "./dist",
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}